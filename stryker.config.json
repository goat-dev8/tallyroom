{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "src/irv.ts",
    "src/stv.ts",
    "src/fraction.ts",
    "src/parse.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "audit/mutation/latest.html"
  },
  "jsonReporter": {
    "fileName": "audit/mutation/latest.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "no-tsconfig-for-stryker.json",
  "disableTypeChecks": false
}
