{
  "name": "tallyroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "parity:maine": "tsx scripts/parity.ts maine",
    "parity": "tsx scripts/parity.ts",
    "precompute": "tsx scripts/precompute-rounds.ts",
    "build": "tsx scripts/precompute-rounds.ts && tsc --noEmit && vitest run && node scripts/copy-fixtures.mjs && next build --webpack",
    "dev": "node scripts/copy-fixtures.mjs && next dev --webpack",
    "start": "next start"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.31",
    "stream-json": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "geist": "^1.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  }
}
